{
  "id": "mpos",
  "realm": "mpos",
  "enabled": true,
  "displayName": "MCPEncode",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "mpos-readonly",
        "description": "Read-only access to the shared MCPEncode library"
      },
      {
        "name": "mpos-editor",
        "description": "Edit access to the shared MCPEncode library"
      }
    ]
  },
  "users": [
    {
      "username": "reader",
      "enabled": true,
      "email": "reader@mpos.local",
      "emailVerified": true,
      "firstName": "MCPEncode",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "reader-pass",
          "temporary": false
        }
      ],
      "realmRoles": ["mpos-readonly"]
    },
    {
      "username": "editor",
      "enabled": true,
      "email": "editor@mpos.local",
      "emailVerified": true,
      "firstName": "MCPEncode",
      "lastName": "Editor",
      "credentials": [
        {
          "type": "password",
          "value": "editor-pass",
          "temporary": false
        }
      ],
      "realmRoles": ["mpos-editor"]
    }
  ],
  "clients": [
    {
      "clientId": "mpos-mcp",
      "name": "Cursor MCP",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "http://127.0.0.1:3000",
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "client.secret.creation.time": "0"
      },
      "protocolMappers": [
        {
          "name": "mpos-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://127.0.0.1:3000/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "mpos-web",
      "name": "MCPEncode HTML UI",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "http://127.0.0.1:3000",
      "baseUrl": "/",
      "redirectUris": ["http://127.0.0.1:3000/callback"],
      "webOrigins": ["http://127.0.0.1:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:3000/*"
      },
      "protocolMappers": [
        {
          "name": "mpos-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://127.0.0.1:3000/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
