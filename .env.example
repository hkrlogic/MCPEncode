# Local publisher. scripts/init-env.sh copies this file and fills the blank secrets.
PUBLIC_BASE_URL=http://127.0.0.1:3000
PORT=3000
BIND_HOST=127.0.0.1

# Required. scripts/init-env.sh fills these in.
SESSION_SECRET=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mpos
POSTGRES_PASSWORD=
POSTGRES_DATABASE=mpos

# Optional. Instead of the POSTGRES_* lines: postgresql://user:password@host:5432/database
# DATABASE_URL=
# Required for any non-local Postgres: required (TLS, preferred) or disable (trusted private network only).
# POSTGRES_SSL=required

# Public deploys: set SETUP_TOKEN (16+ characters, e.g. openssl rand -base64 18) so only you can
# create the first account. PUBLIC_BASE_URL must then be the https:// address people open.
# SETUP_TOKEN=
# Extra hostnames that may reach the app (comma-separated), e.g. www.library.example.org
# ALLOWED_HOSTS=
# Pin remote OAuth callbacks for MCP clients to these hostnames (comma-separated)
# OAUTH_REDIRECT_HOSTS=
