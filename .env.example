# Publisher origin. Library MCP URLs are {PUBLIC_BASE_URL}/libraries/{id}/mcp.
# Use 127.0.0.1, not localhost — they are different token audiences.
# On a public deploy, use the same hostname people open in the browser.
PUBLIC_BASE_URL=http://127.0.0.1:3000
PORT=3000
BIND_HOST=127.0.0.1

# Leave AUTH_MODE unset (or set embedded) to use the built-in development IdP.
# Set AUTH_MODE=oidc and start Keycloak when you want an external issuer.
# Library MCP links need the IdP to mint audience = that library URL (resource).
# The embedded IdP does this. Keycloak needs resource-indicator support configured.
# AUTH_MODE=oidc
# AUTH_ISSUER=http://127.0.0.1:8080/realms/mpos

# Audience for the web UI login token (not a library MCP link).
AUTH_AUDIENCE=http://127.0.0.1:3000

# Browser UI OAuth client (public + PKCE). Redirect: {PUBLIC_BASE_URL}/callback
WEB_CLIENT_ID=mpos-web

# Optional extra hostnames for Host / Origin checks (comma-separated, no scheme).
# Use when www and apex both hit the app, or during a domain cutover.
# ALLOWED_HOSTS=mcpencode.com,www.mcpencode.com

# HMAC secret for the httpOnly UI session cookie. Generate a long random string.
SESSION_SECRET=change-me-to-a-long-random-value

# Postgres. Defaults match the docker compose service, which listens on 127.0.0.1 only.
# These passwords are for this laptop. Change them before anyone else can reach the host.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mpos
POSTGRES_PASSWORD=mpos-local-dev
POSTGRES_DATABASE=mpos
# Railway: on the app service, set DATABASE_URL=${{Postgres.DATABASE_URL}}
# (Postgres is that service's name). Private *.railway.internal needs no TLS.
# Local Docker (127.0.0.1) needs no TLS. For any other host, set one of:
# POSTGRES_SSL=required
# POSTGRES_SSL=disable
# (disable only on a trusted private network — prefer required in production)
