# Canonical MCP resource URL. Must match the token audience exactly.
# Use 127.0.0.1, not localhost — they are different audiences.
MCP_RESOURCE_URL=http://127.0.0.1:3000/mcp
PORT=3000
BIND_HOST=127.0.0.1

# Leave AUTH_MODE unset (or set embedded) to use the built-in development IdP.
# Set AUTH_MODE=oidc and start Keycloak when you want an external issuer.
# AUTH_MODE=oidc
# AUTH_ISSUER=http://127.0.0.1:8080/realms/mpos

AUTH_AUDIENCE=http://127.0.0.1:3000/mcp

# Browser UI OAuth client (public + PKCE). Redirect: {PUBLIC_BASE_URL}/callback
WEB_CLIENT_ID=mpos-web
PUBLIC_BASE_URL=http://127.0.0.1:3000

# HMAC secret for the httpOnly UI session cookie. Generate a long random string.
SESSION_SECRET=change-me-to-a-long-random-value

# MariaDB. Defaults match the docker compose service, which listens on 127.0.0.1 only.
# These passwords are for this laptop. Change them before anyone else can reach the host.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=mpos
MARIADB_PASSWORD=mpos-local-dev
MARIADB_DATABASE=mpos
# Used by npm test to create a throwaway database. The app itself does not use root.
MARIADB_ROOT_PASSWORD=mpos-root-local
# Set to required when MariaDB is not on this machine. Leave unset for local Docker.
# MARIADB_SSL=required
