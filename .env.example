# Local publisher. scripts/init-env.sh copies this file and fills the blank secrets.
PUBLIC_BASE_URL=http://127.0.0.1:3000
PORT=3000
BIND_HOST=127.0.0.1

# Required. scripts/init-env.sh fills in SESSION_SECRET, POSTGRES_PASSWORD and SETUP_TOKEN.
SESSION_SECRET=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mpos
POSTGRES_PASSWORD=
POSTGRES_DATABASE=mpos

# Optional. Instead of the POSTGRES_* lines: postgresql://user:password@host:5432/database
# DATABASE_URL=
# Required for any non-local Postgres: required (TLS, preferred) or disable (trusted private network only).
# POSTGRES_SSL=required
# How long startup keeps retrying an unreachable Postgres, in seconds (0 = try once). Default 60.
# POSTGRES_CONNECT_TIMEOUT_SECONDS=60

# Every public deploy needs SETUP_TOKEN (16+ characters) so only you can create the first account.
# scripts/init-env.sh fills it in (and adds it to an existing .env that has none). To choose your
# own: openssl rand -base64 18. PUBLIC_BASE_URL must then be the https:// address people open.
SETUP_TOKEN=
# Extra hostnames that may reach the app (comma-separated), e.g. www.library.example.org
# ALLOWED_HOSTS=
# MCP client sign-in callbacks. By default only loopback (http://127.0.0.1, [::1], localhost)
# and app schemes (cursor://...) are accepted. Add hosted clients' https hostnames here,
# e.g. claude.ai for Claude custom connectors (comma-separated).
# OAUTH_REDIRECT_HOSTS=
# Accept a callback on any https host. Leave off unless you understand docs/deploy.md.
# OAUTH_ALLOW_ANY_HTTPS_REDIRECT=false
# Keep the old shared client id "mpos-mcp" working for loopback/app-scheme callbacks.
# Set false once every MCP client has reconnected and registered its own id.
# OAUTH_LEGACY_CLIENT=true
# A sign-in's refresh tokens stop working this many days after sign-in (1-365).
# OAUTH_REFRESH_MAX_DAYS=30
