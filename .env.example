# MCPEncode settings. Create .env with: scripts/init-env.sh (fills every secret).
# Most installs change only these lines:
PUBLIC_BASE_URL=http://127.0.0.1:3000
PORT=3000
# Code the first-account page asks for (16+ characters). init-env.sh generates it.
SETUP_TOKEN=
# Sign in through an external identity provider instead of built-in accounts (docs/oidc.md).
# AUTH_MODE=oidc

# --- Advanced: filled by scripts/init-env.sh. Every setting is in docs/deploy.md. ---
SESSION_SECRET=
POSTGRES_PASSWORD=
