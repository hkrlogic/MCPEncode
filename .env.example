# Publisher origin. Library MCP URLs are {PUBLIC_BASE_URL}/libraries/{id}/mcp.
# Use 127.0.0.1, not localhost — they are different token audiences.
# On a public deploy, use the same hostname people open in the browser.
PUBLIC_BASE_URL=http://127.0.0.1:3000
PORT=3000
BIND_HOST=127.0.0.1

# Leave AUTH_MODE unset to use sign-in built into the app.
# The first visit creates the account. There is no demo password.
# Optional external identity provider: docker compose up -d, then npm run zitadel:bootstrap.
# Bootstrap writes AUTH_MODE, AUTH_ISSUER, AUTH_AUDIENCE, and the client ids.
# AUTH_MODE=oidc
# AUTH_ISSUER=http://127.0.0.1:8080

# Embedded: web UI origin. After bootstrap: the Zitadel project id (token audience).
AUTH_AUDIENCE=http://127.0.0.1:3000

# Browser UI OAuth client (public + PKCE). Redirect: {PUBLIC_BASE_URL}/callback
# Bootstrap replaces this with the client id Zitadel generates.
WEB_CLIENT_ID=mpos-web

# Zitadel (loopback only). Use another port if 8080 is already taken.
ZITADEL_HOST_PORT=8080
# Masterkey must be exactly 32 characters (scripts/init-env.sh fills these in).
# openssl rand -hex 16
# Losing ZITADEL_MASTERKEY makes the Zitadel database unreadable.
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_LOGIN_COOKIE_SECRET=
ZITADEL_ADMIN_USERNAME=zitadel-admin
ZITADEL_ADMIN_PASSWORD=
# Only for optional Zitadel bootstrap. Leave blank unless you run it.
# Zitadel requires upper, lower, number, and symbol. Do not commit real values.
ZITADEL_EDITOR_PASSWORD=
ZITADEL_READER_PASSWORD=

# Optional extra hostnames for Host / Origin checks (comma-separated, no scheme).
# Use when www and apex both hit the app, or during a domain cutover.
# ALLOWED_HOSTS=mcpencode.com,www.mcpencode.com

# HMAC secret for the httpOnly UI session cookie. Required. The app refuses to
# start with a short, repetitive, or placeholder value.
# Generate: openssl rand -base64 48   (scripts/init-env.sh fills this in)
SESSION_SECRET=

# Postgres. Matches the docker compose service, which listens on 127.0.0.1 only.
# Required. Generate: openssl rand -hex 24   (scripts/init-env.sh fills this in)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mpos
POSTGRES_PASSWORD=
POSTGRES_DATABASE=mpos
# Railway app service — reference each value from the Postgres service:
# POSTGRES_HOST=${{Postgres.PGHOST}}  POSTGRES_PORT=${{Postgres.PGPORT}}
# POSTGRES_USER=${{Postgres.PGUSER}}  POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}
# POSTGRES_DATABASE=${{Postgres.PGDATABASE}}
# Private *.railway.internal needs no TLS. A full DATABASE_URL also works.
# Local Docker (127.0.0.1) needs no TLS. For any other host, set one of:
# POSTGRES_SSL=required
# POSTGRES_SSL=disable
# (disable only on a trusted private network — prefer required in production)
